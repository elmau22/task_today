PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Wajib di production: string acak >= 32 karakter (mis. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Akun admin pertama (dibuat hanya jika belum ada admin)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@lokalkreatif.com
ADMIN_PASSWORD=

# Email kontak -> info@lokalkreatif.com (isi SMTP agar benar-benar terkirim)
CONTACT_TO=info@lokalkreatif.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
